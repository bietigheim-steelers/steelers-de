<script{{ attrs().setIfExists('nonce', csp_nonce('script-src')) }}>
{% verbatim %}
(function () {
    'use strict';

    var script = document.currentScript;
    var form = (script && script.parentElement && script.parentElement.querySelector('form')) || null;
    if (!form || form.getAttribute('data-sf') || !window.CSS || !CSS.supports('selector(:has(*))')) { return; }
    form.setAttribute('data-sf', '1');
    form.noValidate = true;

    var formbody = form.querySelector('.formbody') || form;

    // --- Helfer --------------------------------------------------------------
    function el(tag, cls, html) {
        var e = document.createElement(tag);
        if (cls) { e.className = cls; }
        if (html != null) { e.innerHTML = html; }
        return e;
    }
    function esc(s) {
        return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; });
    }
    function controls(n) {
        return [].slice.call(form.querySelectorAll('[name="' + n + '"]')).filter(function (e) { return e.type !== 'hidden'; });
    }
    function widgetOf(n) { var c = controls(n)[0]; return c ? c.closest('.widget') : null; }
    function isChoice(c) { return c && (c.type === 'radio' || c.type === 'checkbox'); }
    function val(n) {
        var c = controls(n);
        if (!c.length) { return ''; }
        if (isChoice(c[0])) {
            return c.filter(function (x) { return x.checked; }).map(function (x) { return x.value; }).join(',');
        }
        return String(c[0].value || '').trim();
    }
    function attr(n, name) { var c = controls(n)[0]; return c ? (c.getAttribute(name) || '') : ''; }
    function cleanLabel(text) {
        return String(text).replace(/\*/g, '').replace(/\boptional\b\s*$/, '').replace(/\s+/g, ' ')
            .replace(/\s*[=:–-]?\s*\d+(?:[.,]\d{1,2})?\s*€.*$/, '').trim();
    }
    function labelText(n) {
        var w = widgetOf(n), l = w && w.querySelector('label, legend');
        return l ? cleanLabel(l.textContent) : n;
    }
    function rawLabel(n) {
        var w = widgetOf(n), l = w && w.querySelector('label, legend');
        return l ? l.textContent : '';
    }
    function isRequired(n) {
        var w = widgetOf(n), c = controls(n)[0];
        return !!(c && (c.required || (w && w.classList.contains('mandatory'))));
    }
    function money(n) { return n.toFixed(2).replace('.', ',') + ' €'; }
    function parsePrice(text) {
        var m = /(\d+(?:[.,]\d{1,2})?)\s*€/.exec(text || '');
        return m ? parseFloat(m[1].replace(',', '.')) : null;
    }
    function parseSurcharge(text) {
        var m = /zzgl\.?\s*(\d+(?:[.,]\d{1,2})?)\s*€/i.exec(text || '');
        return m ? parseFloat(m[1].replace(',', '.')) : 0;
    }
    function fill(tpl, vars) {
        return String(tpl).replace(/\{(\w+)\}/g, function (m, k) { return vars[k] != null ? vars[k] : m; })
            .replace(/\s+/g, ' ').replace(/\s+([.,])/g, '$1').trim();
    }
    function reduced() { return window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches; }

    // --- Schritte aus den Fieldsets ableiten -------------------------------------------
    var groups = [], loose = [], submitWidget = null;
    [].slice.call(formbody.children).forEach(function (ch) {
        if (ch.tagName === 'FIELDSET') {
            var ws = [].slice.call(ch.querySelectorAll('.widget')).filter(function (w) {
                if (w.classList.contains('widget-submit')) { submitWidget = w; return false; }
                return true;
            });
            if (!ws.length) { return; }
            var legend = ch.querySelector(':scope > legend');
            groups.push({
                title: legend ? legend.textContent.trim() : '',
                lead: ch.getAttribute('data-step-lead') || '',
                widgets: loose.concat(ws)
            });
            loose = [];
        } else if (ch.classList && ch.classList.contains('widget')) {
            if (ch.classList.contains('widget-submit')) { submitWidget = ch; }
            else if (groups.length) { groups[groups.length - 1].widgets.push(ch); }
            else { loose.push(ch); }
        }
    });
    if (loose.length) { groups.push({ title: '', lead: '', widgets: loose }); }
    if (!groups.length) { return; }

    function namesOf(widgets) {
        var out = [];
        widgets.forEach(function (w) {
            if (w.classList.contains('widget-captcha') || w.classList.contains('widget-explanation')) { return; }
            [].forEach.call(w.querySelectorAll('input, select, textarea'), function (c) {
                if (c.name && c.type !== 'hidden' && c.type !== 'button' && out.indexOf(c.name) === -1) { out.push(c.name); }
            });
        });
        return out;
    }
    var allNames = [];

    // --- Server-Fehler einsammeln (Contao rendert <p class="error"> in die Felder) ------
    var errs = {}, touched = {}, dirty = {}, serverErrors = [], extraErrors = [];
    form.querySelectorAll('.widget p.error').forEach(function (p) {
        var w = p.closest('.widget'), c = w && w.querySelector('[name]');
        serverErrors.push({ name: c ? c.name : '', msg: p.textContent.trim(),
            visible: !!(w && w.style.display !== 'none' && !w.classList.contains('widget-captcha')) });
        p.remove();
    });

    // --- Aufbau ----------------------------------------------------------------------
    var single = groups.length === 1;
    var sf = el('div', 'sf');
    var progress = el('ol', 'sf-progress'); progress.hidden = single;
    var restoreNote = el('div', 'sf-restore'); restoreNote.hidden = true;
    var summary = el('div', 'sf-summary'); summary.hidden = true; summary.tabIndex = -1;
    sf.appendChild(progress); sf.appendChild(restoreNote); sf.appendChild(summary);

    var steps = groups.map(function (g, i) {
        var sec = el('section', 'sf-step'); sec.hidden = true;
        var title = g.title || (single ? '' : 'Schritt ' + (i + 1));
        var h = el('h3', 'sf-title', esc(title)); h.tabIndex = -1; h.id = 'sf-h' + i;
        if (title) { sec.appendChild(h); sec.setAttribute('aria-labelledby', h.id); }
        if (g.lead) { sec.appendChild(el('p', 'sf-lead', esc(g.lead))); }
        g.widgets.forEach(function (w) { sec.appendChild(w); });
        sf.appendChild(sec);
        var names = namesOf(g.widgets);
        names.forEach(function (n) { allNames.push(n); });
        var li = el('li');
        var b = el('button', 'sf-pstep', '<b>Schritt ' + (i + 1) + '</b><span>' + esc(title) + '</span>');
        b.type = 'button';
        b.setAttribute('aria-label', 'Schritt ' + (i + 1) + ' von ' + groups.length + (title ? ': ' + title : ''));
        b.addEventListener('click', function () { if (i <= maxVisited) { go(i, true); } });
        li.appendChild(b); progress.appendChild(li);
        return { title: title, sec: sec, btn: b, names: names, heading: h };
    });
    var lastIdx = steps.length - 1;
    form.querySelectorAll('fieldset').forEach(function (f) {
        if (!sf.contains(f) && !f.querySelector('.widget')) { f.hidden = true; }
    });

    var recap = el('div', 'sf-recap'); recap.hidden = true;
    steps[lastIdx].sec.appendChild(recap);

    var nav = el('div', 'sf-nav');
    var back = el('button', 'sf-back', '← Zurück'); back.type = 'button';
    var next = el('button', 'btn-default', 'Weiter'); next.type = 'button';
    var right = el('div', 'sf-nav-right');
    right.appendChild(next);
    if (submitWidget) { right.appendChild(submitWidget); }
    nav.appendChild(back); nav.appendChild(right);
    sf.appendChild(nav);
    formbody.appendChild(sf);

    // --- Felder aufbereiten ---------------------------------------------------------------
    var AUTOCOMPLETE = [
        [/vorname|firstname|first_name/i, 'given-name'], [/nachname|lastname|last_name|familienname/i, 'family-name'],
        [/strasse|straße|street/i, 'street-address'], [/^plz|postleitzahl|zip|postal/i, 'postal-code'],
        [/^ort$|stadt|city/i, 'address-level2'], [/mail/i, 'email'], [/telefon|phone|mobil|handy/i, 'tel']
    ];
    allNames.forEach(function (n) {
        var w = widgetOf(n), cs = controls(n);
        if (!w) { return; }
        cs.forEach(function (c) {
            if (c.tagName === 'INPUT' && !isChoice(c)) {
                c.setAttribute('enterkeyhint', 'next');
                if (!c.getAttribute('autocomplete')) {
                    AUTOCOMPLETE.some(function (a) {
                        if (a[0].test(n)) {
                            c.setAttribute('autocomplete', a[1]);
                            if (a[1] === 'postal-code' && !c.getAttribute('inputmode')) { c.setAttribute('inputmode', 'numeric'); }
                            return true;
                        }
                        return false;
                    });
                }
            }
        });
        // Statt Sternchen bei Pflichtfeldern: "optional" bei den freiwilligen
        var l = w.querySelector('label, legend');
        if (l && !isRequired(n) && !l.querySelector('.sf-opt')) { l.appendChild(el('span', 'sf-opt', 'optional')); }
    });

    // --- Mengenfelder mit +/- --------------------------------------------------------------
    allNames.forEach(function (n) {
        var input = controls(n)[0];
        if (!input || input.tagName !== 'INPUT' || input.type !== 'number') { return; }
        var wrap = input.parentElement;
        wrap.classList.add('sf-stepper');
        var min = input.getAttribute('min') !== null && input.getAttribute('min') !== '' ? parseInt(input.min, 10) : 0;
        var max = input.getAttribute('max') !== null && input.getAttribute('max') !== '' ? parseInt(input.max, 10) : 999;
        input.setAttribute('inputmode', 'numeric'); input.setAttribute('autocomplete', 'off');
        if (!input.getAttribute('step')) { input.step = '1'; }
        var label = labelText(n);
        var minus = el('button', null, '−'), plus = el('button', null, '+');
        minus.type = plus.type = 'button';
        minus.setAttribute('aria-label', label + ': eins weniger');
        plus.setAttribute('aria-label', label + ': eins mehr');
        function bump(delta) {
            var cur = parseInt(input.value, 10);
            var nxt = isNaN(cur) ? (delta > 0 ? Math.max(min, 1) : Math.max(min, 0)) : Math.max(min, Math.min(max, cur + delta));
            input.value = String(nxt);
            input.dispatchEvent(new Event('input', { bubbles: true }));
            touched[n] = true;
        }
        minus.addEventListener('click', function () { bump(-1); });
        plus.addEventListener('click', function () { bump(1); });
        wrap.insertBefore(minus, input); wrap.appendChild(plus);
    });

    // --- Summengruppen -----------------------------------------------------------------------
    var sums = {}; // Gruppe -> { names, min, unit, message, box }
    allNames.forEach(function (n) {
        var g = attr(n, 'data-sf-sum-group');
        if (!g) { return; }
        var s = sums[g] || (sums[g] = { names: [], min: 0, unit: '', message: '', box: null });
        s.names.push(n);
        s.min = Math.max(s.min, parseInt(attr(n, 'data-sf-sum-min'), 10) || 0);
        s.unit = s.unit || attr(n, 'data-sf-sum-unit');
        s.message = s.message || attr(n, 'data-sf-sum-message');
    });
    var sumOf = {};
    Object.keys(sums).forEach(function (g) {
        var s = sums[g];
        s.names.forEach(function (n) { sumOf[n] = g; });
        var lastW = widgetOf(s.names[s.names.length - 1]);
        if (lastW) {
            s.box = el('div', 'sf-group'); s.box.setAttribute('aria-live', 'polite');
            lastW.parentNode.insertBefore(s.box, lastW.nextSibling);
        }
    });
    function unitPrice(n) { return controls(n)[0] && controls(n)[0].type === 'number' ? parsePrice(rawLabel(n)) : null; }
    function sumTotal(s) {
        return s.names.reduce(function (a, n) { return a + (parseInt(val(n), 10) || 0); }, 0);
    }
    function sumMoney(s) {
        var any = false, total = 0;
        s.names.forEach(function (n) {
            var u = unitPrice(n);
            if (u != null) { any = true; total += (parseInt(val(n), 10) || 0) * u; }
        });
        return any ? total : null;
    }
    function updateSums() {
        Object.keys(sums).forEach(function (g) {
            var s = sums[g]; if (!s.box) { return; }
            var total = sumTotal(s), u = s.unit ? ' ' + s.unit : '', ok = total >= s.min;
            s.box.classList.toggle('is-ok', ok && total > 0);
            if (!total) { s.box.innerHTML = s.min ? 'Insgesamt mindestens ' + s.min + esc(u) + '.' : ''; s.box.hidden = !s.min; return; }
            s.box.hidden = false;
            var m = sumMoney(s);
            s.box.innerHTML = '<strong>' + total + esc(u) + '</strong>' + (m != null ? ' · ' + money(m) : '') +
                (s.min ? '<small>' + (ok ? 'Mindestmenge erreicht.' : 'Noch ' + (s.min - total) + ' bis zum Mindestmaß von ' + s.min + esc(u) + '.') + '</small>' : '');
        });
    }

    // --- Validierung -----------------------------------------------------------------------
    var EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
    var PHONE = /^[+\d][\d\s\/().-]{4,}$/;
    function patternOf(src) {
        var m = /^\/([\s\S]*)\/([a-z]*)$/.exec(src);
        try { return m ? new RegExp(m[1], m[2].replace(/[^gimsuy]/g, '')) : null; } catch (e) { return null; }
    }
    function requiredMessage(n) {
        return attr(n, 'data-sf-msg-required') || 'Bitte „' + labelText(n) + '“ ausfüllen.';
    }
    function ruleMessage(n, v) {
        var c = controls(n)[0], rg = attr(n, 'data-sf-rgxp'), custom = attr(n, 'data-sf-msg-invalid'), bad = '';
        if (rg === 'email' || rg === 'friendly') { if (!EMAIL.test(v)) { bad = 'Das sieht noch nicht nach einer E-Mail-Adresse aus, z. B. name@beispiel.de.'; } }
        else if (rg === 'phone') { if (!PHONE.test(v)) { bad = 'Bitte eine gültige Telefonnummer angeben.'; } }
        else if (rg === 'natural') { if (!/^\d+$/.test(v)) { bad = 'Bitte eine ganze Zahl angeben.'; } }
        else if (rg === 'digit') { if (isNaN(Number(v.replace(',', '.')))) { bad = 'Bitte eine Zahl angeben.'; } }
        else if (rg === 'custom') {
            var re = patternOf(attr(n, 'data-sf-pattern'));
            if (re && !re.test(v)) { bad = 'Bitte „' + labelText(n) + '“ prüfen.'; }
        }
        if (!bad && c && c.type === 'number') {
            var num = Number(v.replace(',', '.'));
            if (isNaN(num)) { bad = 'Bitte eine Zahl angeben.'; }
            else if (c.getAttribute('min') !== null && c.min !== '' && num < Number(c.min)) { bad = 'Der Wert muss mindestens ' + c.min + ' betragen.'; }
            else if (c.getAttribute('max') !== null && c.max !== '' && num > Number(c.max)) { bad = 'Der Wert darf höchstens ' + c.max + ' betragen.'; }
        }
        return bad ? (custom || bad) : '';
    }
    function sumMessage(n) {
        var g = sumOf[n]; if (!g) { return ''; }
        var s = sums[g];
        if (s.names[s.names.length - 1] !== n) { return ''; }
        // Fehlende Pflichtangaben meldet das jeweilige Feld selbst
        for (var i = 0; i < s.names.length; i++) { if (isRequired(s.names[i]) && val(s.names[i]) === '') { return ''; } }
        var total = sumTotal(s);
        if (total >= s.min) { return ''; }
        return fill(s.message || 'Bitte insgesamt mindestens {min} {einheit} angeben – es fehlen noch {fehlt}.',
            { min: s.min, summe: total, fehlt: s.min - total, einheit: s.unit });
    }
    function check(n) {
        if (!controls(n).length) { return ''; }
        var v = val(n);
        if (v === '') { return isRequired(n) ? requiredMessage(n) : ''; }
        return ruleMessage(n, v) || sumMessage(n);
    }
    function showError(n, msg) {
        var w = widgetOf(n);
        if (!w) { return; }
        var old = w.querySelector('.sf-error'); if (old) { old.remove(); }
        var cs = controls(n);
        if (msg) {
            errs[n] = msg;
            var p = el('p', 'sf-error', esc(msg)); p.id = 'sf-err-' + n.replace(/\W/g, '_');
            w.appendChild(p);
            cs.forEach(function (c) { c.setAttribute('aria-invalid', 'true'); c.setAttribute('aria-describedby', p.id); });
        } else {
            delete errs[n];
            cs.forEach(function (c) { c.removeAttribute('aria-invalid'); c.removeAttribute('aria-describedby'); });
        }
    }
    function validateOne(n) { var m = check(n); showError(n, m); return m; }
    function stepOf(n) {
        for (var i = 0; i < steps.length; i++) { if (steps[i].names.indexOf(n) !== -1) { return i; } }
        return lastIdx;
    }
    function firstControl(n) { var c = controls(n)[0]; return c && c.offsetParent !== null ? c : null; }

    function renderSummary(i) {
        var items = Object.keys(errs).filter(function (n) { return stepOf(n) === i; });
        items.sort(function (a, b) { return steps[i].names.indexOf(a) - steps[i].names.indexOf(b); });
        extraErrors.forEach(function (e) { items.push(e); });
        if (!items.length) { summary.hidden = true; summary.innerHTML = ''; return; }
        summary.hidden = false;
        summary.setAttribute('role', 'alert');
        summary.innerHTML = '<strong>' + (items.length === 1 ? 'Bitte diese Angabe prüfen:' : 'Bitte diese ' + items.length + ' Angaben prüfen:') + '</strong><ul></ul>';
        var ul = summary.querySelector('ul');
        items.forEach(function (n) {
            var li = el('li'), isExtra = typeof n === 'object';
            var msg = isExtra ? n.msg : errs[n];
            var c = isExtra ? null : firstControl(n);
            if (c) {
                var a = el('a', null, esc(msg)); a.href = '#' + c.id;
                a.addEventListener('click', function (ev) { ev.preventDefault(); c.focus(); });
                li.appendChild(a);
            } else { li.textContent = msg; }
            ul.appendChild(li);
        });
        // Fehler in anderen Schritten (nach einer Server-Antwort) nicht verschweigen
        var others = [];
        Object.keys(errs).forEach(function (n) {
            var k = stepOf(n);
            if (k !== i && others.indexOf(k) === -1) { others.push(k); }
        });
        if (others.length) {
            others.sort();
            var p = el('p', null, 'Weitere Hinweise gibt es in: ' + others.map(function (k) {
                return 'Schritt ' + (k + 1) + (steps[k].title ? ' (' + esc(steps[k].title) + ')' : '');
            }).join(', ') + '.');
            p.style.margin = '.5rem 0 0';
            summary.appendChild(p);
        }
    }
    function validateStep(i, silentSummary) {
        var bad = [];
        steps[i].names.forEach(function (n) { if (validateOne(n)) { bad.push(n); } });
        if (!silentSummary) { renderSummary(i); }
        return bad;
    }
    function focusFirst(i) {
        var bad = Object.keys(errs).filter(function (n) { return stepOf(n) === i; });
        bad.sort(function (a, b) { return steps[i].names.indexOf(a) - steps[i].names.indexOf(b); });
        var c = bad.length ? firstControl(bad[0]) : null;
        if (c) { c.focus(); if (!reduced()) { c.scrollIntoView({ block: 'center', behavior: 'smooth' }); } }
        else if (!summary.hidden) { summary.focus(); }
    }

    // --- Zusammenfassung --------------------------------------------------------------------
    function selectedText(n) {
        var cs = controls(n);
        if (!cs.length) { return ''; }
        if (cs[0].tagName === 'SELECT') { var o = cs[0].options[cs[0].selectedIndex]; return o && o.value !== '' ? o.text : ''; }
        return cs.filter(function (x) { return x.checked; }).map(function (x) {
            var l = form.querySelector('label[for="' + x.id + '"]'); return l ? l.textContent.trim() : x.value;
        }).join(', ');
    }
    function renderRecap() {
        var html = '', priced = false, total = 0, surcharge = 0, anyRow = false;
        steps.forEach(function (s, i) {
            var rows = '';
            s.names.forEach(function (n) {
                var c = controls(n)[0]; if (!c) { return; }
                var v = val(n); if (v === '') { return; }
                var shown;
                if (c.tagName === 'SELECT' || isChoice(c)) {
                    shown = selectedText(n); if (!shown) { return; }
                    surcharge += parseSurcharge(shown);
                    shown = esc(shown);
                } else if (c.type === 'number' && unitPrice(n) != null) {
                    var u = unitPrice(n), q = parseInt(v, 10) || 0;
                    priced = true; total += q * u;
                    shown = q + ' × ' + money(u);
                } else {
                    shown = esc(v.length > 120 ? v.slice(0, 120) + '…' : v);
                }
                rows += '<dt>' + esc(labelText(n)) + '</dt><dd>' + shown + '</dd>';
            });
            if (rows) {
                anyRow = true;
                html += '<h5><span>' + esc(s.title || 'Angaben') + '</span>' +
                    (i === lastIdx ? '' : '<button type="button" data-sf-edit="' + i + '">Ändern</button>') + '</h5><dl>' + rows + '</dl>';
            }
        });
        if (priced) {
            html += '<dl>' + (surcharge ? '<dt>Aufpreis laut Auswahl</dt><dd>' + money(surcharge) + '</dd>' : '') +
                '<dt class="is-total">Gesamt</dt><dd class="is-total">' + money(total + surcharge) + '</dd></dl>';
        }
        recap.innerHTML = '<h4>Eure Angaben</h4>' + html;
        recap.hidden = !anyRow;
    }
    recap.addEventListener('click', function (e) {
        var b = e.target.closest('[data-sf-edit]');
        if (b) { go(parseInt(b.getAttribute('data-sf-edit'), 10), true); }
    });

    // --- Navigation ---------------------------------------------------------------------------
    var cur = 0, maxVisited = 0;
    function go(i, focusHeading) {
        cur = i; maxVisited = Math.max(maxVisited, i);
        steps.forEach(function (s, k) {
            s.sec.hidden = k !== i;
            s.btn.classList.toggle('is-current', k === i);
            s.btn.classList.toggle('is-done', k < i);
            s.btn.disabled = k > maxVisited;
            if (k === i) { s.btn.setAttribute('aria-current', 'step'); } else { s.btn.removeAttribute('aria-current'); }
        });
        back.hidden = i === 0;
        next.hidden = i === lastIdx;
        if (submitWidget) { submitWidget.hidden = i !== lastIdx; }
        if (i === lastIdx) { renderRecap(); }
        renderSummary(i);
        if (focusHeading) {
            if (!reduced()) { sf.scrollIntoView({ block: 'start', behavior: 'smooth' }); } else { sf.scrollIntoView(); }
            steps[i].heading.focus({ preventScroll: true });
        }
    }
    next.addEventListener('click', function () {
        var bad = validateStep(cur);
        if (bad.length) { focusFirst(cur); return; }
        go(cur + 1, true);
    });
    back.addEventListener('click', function () { if (cur > 0) { go(cur - 1, true); } });

    // Enter in einem Feld darf nicht vorzeitig absenden
    form.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' && cur < lastIdx && e.target.tagName === 'INPUT' && e.target.type !== 'button') {
            e.preventDefault(); next.click();
        }
    });
    form.addEventListener('submit', function (e) {
        if (cur < lastIdx) { e.preventDefault(); next.click(); return; }
        var firstBad = -1;
        steps.forEach(function (s, i) {
            var bad = validateStep(i, true);
            if (bad.length && firstBad === -1) { firstBad = i; }
        });
        if (firstBad !== -1) {
            e.preventDefault();
            go(firstBad, firstBad !== cur);
            renderSummary(firstBad);
            focusFirst(firstBad);
            return;
        }
        clearDraft();
    });

    // --- Live-Pruefung --------------------------------------------------------------------------
    form.addEventListener('input', function (e) {
        var n = e.target.name; if (!n) { return; }
        dirty[n] = true; afterChange(n, false);
    });
    form.addEventListener('change', function (e) {
        var n = e.target.name; if (!n) { return; }
        dirty[n] = true; afterChange(n, e.target.tagName === 'SELECT' || isChoice(e.target));
    });
    form.addEventListener('focusout', function (e) {
        var n = e.target.name;
        if (!n || !sf.contains(e.target) || isChoice(e.target)) { return; }
        if (dirty[n] || val(n) !== '') { touched[n] = true; validateOne(n); refresh(); }
    });
    function afterChange(n, validateNow) {
        if (errs[n] || validateNow) { validateOne(n); }
        // Summenregel haengt am letzten Feld der Gruppe
        var g = sumOf[n];
        if (g) {
            var lastN = sums[g].names[sums[g].names.length - 1];
            if (lastN !== n && (errs[lastN] || touched[lastN])) { validateOne(lastN); }
        }
        refresh();
        saveDraft();
    }
    function refresh() {
        updateSums();
        if (!summary.hidden) { renderSummary(cur); }
        if (cur === lastIdx) { renderRecap(); }
    }

    // --- Entwurf (nur diese Browser-Sitzung) ------------------------------------------------------
    var formSubmit = (form.querySelector('[name="FORM_SUBMIT"]') || {}).value || '';
    var draftKey = 'sf-draft:' + location.pathname + ':' + formSubmit;
    var skip = /^(captcha|REQUEST_TOKEN|FORM_SUBMIT)/;
    var timer;
    function store(fn) { try { return fn(window.sessionStorage); } catch (err) { return null; } }
    function saveDraft() {
        clearTimeout(timer);
        timer = setTimeout(function () {
            var data = {};
            allNames.forEach(function (n) { if (!skip.test(n) && val(n) !== '') { data[n] = val(n); } });
            store(function (s) { s.setItem(draftKey, JSON.stringify(data)); });
        }, 300);
    }
    function clearDraft() { clearTimeout(timer); store(function (s) { s.removeItem(draftKey); }); }
    // "Unberuehrt": alle Felder stehen noch auf dem Wert, den der Server ausgeliefert hat
    function isPristine() {
        return !serverErrors.length && allNames.every(function (n) {
            return controls(n).every(function (c) {
                if (isChoice(c)) { return c.checked === c.defaultChecked; }
                if (c.tagName === 'SELECT') {
                    var def = [].findIndex.call(c.options, function (o) { return o.defaultSelected; });
                    return c.selectedIndex === (def === -1 ? 0 : def);
                }
                return c.value === c.defaultValue;
            });
        });
    }
    function restoreDraft() {
        var raw = store(function (s) { return s.getItem(draftKey); });
        if (!raw) { return false; }
        var data; try { data = JSON.parse(raw); } catch (err) { return false; }
        var any = false;
        Object.keys(data).forEach(function (n) {
            var cs = controls(n); if (!cs.length) { return; }
            if (isChoice(cs[0])) {
                var picked = String(data[n]).split(',');
                cs.forEach(function (r) { r.checked = picked.indexOf(r.value) !== -1; });
            } else if (cs[0].tagName === 'SELECT') {
                var ok = [].some.call(cs[0].options, function (o) { return o.value === data[n] && !o.disabled; });
                if (!ok) { return; }
                cs[0].value = data[n];
            } else { cs[0].value = data[n]; }
            any = true;
        });
        return any;
    }

    // --- Start ------------------------------------------------------------------------------------
    var startStep = 0;
    if (isPristine() && restoreDraft()) {
        restoreNote.hidden = false;
        restoreNote.innerHTML = '<span>Eure bisherigen Eingaben wurden wiederhergestellt.</span>';
        var reset = el('button', null, 'Neu beginnen'); reset.type = 'button';
        reset.addEventListener('click', function () { clearDraft(); location.reload(); });
        restoreNote.appendChild(reset);
    }
    if (serverErrors.length) {
        // Der Server hat abgelehnt: Meldungen am Feld anzeigen, in den ersten betroffenen Schritt springen
        var first = lastIdx;
        serverErrors.forEach(function (s) {
            // Fehler ohne sichtbares Feld (z. B. Sicherheitsfrage) zaehlen fuer den Sprung nicht mit
            if (s.name && widgetOf(s.name) && s.visible) { touched[s.name] = true; showError(s.name, s.msg); first = Math.min(first, stepOf(s.name)); }
            else { extraErrors.push({ msg: s.msg }); }
        });
        maxVisited = lastIdx;
        startStep = first;
    }
    updateSums();
    go(startStep, serverErrors.length > 0);
    if (serverErrors.length) { focusFirst(startStep); }
    extraErrors = [];
})();
