{#
    Zeitstrahl des Business-Themes ("about-us-our-journey").

    Markup und Klassen stammen 1:1 aus about-us.html. Das Theme kennt genau vier
    Eintraege pro Block – Desktop vier Spalten mit waagerechter Linie, mobil zwei
    Spalten mit senkrechter Linie. Der Controller liefert die Eintraege deshalb in
    Vierergruppen; jede Gruppe ist ein eigener [data-journey-section]-Block.

    Position innerhalb der Gruppe:
      gerade (0, 2) -> Karte unter der Linie, Pfeil oben
      ungerade (1, 3) -> Karte ueber der Linie, Pfeil unten
      mobile Zeile (0/1 vs. 2/3) steuert pt-0/pt-10 und top-14/top-23.5

    Wie die uebrigen Business-Inhaltselemente ohne eigenen <section>/.container-
    Rahmen – den liefert das Artikel-Template (mod_article_business_container).
#}
{% extends '@Contao/content_element/_base.html.twig' %}
{% use '@Contao/component/_headline.html.twig' %}
{% use '@Contao/component/_rich_text.html.twig' %}

{% block inner %}
    {% if label or headline.text|default or text|default %}
        <div class="flex items-start justify-between gap-4 md:gap-10 mb-12 sm:mb-14 md:mb-16 lg:mb-20 flex-col md:flex-row max-w-125 md:max-w-full" data-section-title>
            <div class="md:max-w-170 w-full">
                {% if label %}
                    <div class="flex items-center gap-2.5">
                        <img class="rotate" src="/files/business/img/title-icon.svg" alt="" width="18" height="18">
                        <span class="text-base lg:text-lg font-semibold leading-[1.1]! text-secondary uppercase block">{{ label }}</span>
                    </div>
                {% endif %}

                {% if headline.text|default %}
                    {% with {headline: {
                        text: headline.text,
                        tag_name: headline.tag_name|default('h2'),
                        attributes: attrs(headline.attributes|default)
                            .addClass('text-3xl md:text-4xl lg:text-[40px] xl:text-5xl font-bold leading-tight text-title_black' ~ (label ? ' mt-4' : ''))
                            .set('data-content')
                    }} %}
                        {{ block('headline_component') }}
                    {% endwith %}
                {% endif %}
            </div>

            {% if text|default %}
                {% with {text, attributes: attrs()
                    .addClass('md:max-w-115 w-full text-base sm:text-lg text-paragraph_black')
                    .set('data-content')
                } %}
                    {{ block('rich_text_component') }}
                {% endwith %}
            {% endif %}
        </div>
    {% endif %}

    {% for group in groups %}
        <div class="max-w-320 h-auto relative{{ loop.first ? '' : ' mt-20' }}" data-journey-section>
            <div class="absolute top-0 md:top-1/2 left-1/2 -translate-x-1/2 md:translate-x-0 md:left-0 w-[2px] md:w-full h-full md:h-0.5 bg-paragraph_white  md:translate-y-1/2" data-sttr-line></div>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-10  xl:gap-15">
                {% for entry in group %}
                    {# mobile Zeile innerhalb der Gruppe: 0 = obere, 1 = untere #}
                    {% set mobileRow = loop.index0 // 2 %}

                    {% if loop.index0 is even %}
                        <div class="relative flex flex-col items-center {{ mobileRow == 0 ? 'pt-0' : 'pt-10' }} md:pt-8">
                            <div class="hidden md:block absolute  top-1/2 -translate-y-1/2 w-5 h-5 rounded-full border-5 border-primary bg-title_white z-10 shadow-sm " data-sttr-dots></div>
                            <div class="md:mt-32 bg-background py-6 px-3 lg:px-7  rounded-2xl border border-paragraph_white text-center  max-w-53 w-full relative shadow-sm" data-sttr-card>
                                <div class=" absolute top-1/2 -translate-y-1/2 -right-[15px] md:right-1/3 rotate-90 md:rotate-0 md:top-[-11px] md:left-1/2 md:-translate-x-1/2 md:translate-y-0">
                                    <svg width="20" height="11" viewBox="0 0 20 11" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M10.207 0.728516L1.20703 9.72852H18.207L10.207 0.728516Z" fill="#FBFBFB" stroke="#E5E5E5"/>
                                    </svg>
                                </div>
                                <h3 class="text-2xl font-semibold leading-none text-title_black">{{ entry.year }}</h3>
                                <p class="text-paragraph_black text-sm mt-4 font-normal">{{ entry.text }}</p>
                            </div>
                        </div>
                    {% else %}
                        <div class="relative flex flex-col items-center  {{ mobileRow == 0 ? 'pt-0' : 'pt-10' }} md:pt-8 ">
                            <div class=" absolute {{ mobileRow == 0 ? 'top-14' : 'top-23.5' }} md:top-1/2 -translate-y-1/2 w-4 sm:w-5 h-4 sm:h-5 left-[-18.75px] md:left-1/2 -translate-x-1/2 rounded-full border-5 border-primary bg-title_white z-10 shadow-sm" data-sttr-dots></div>
                            <div class="md:-mt-8 bg-background py-6 px-3 lg:px-7 rounded-2xl border border-paragraph_white text-center  max-w-53 w-full relative shadow-sm " data-sttr-card>
                                <div class=" absolute bottom-12 md:-bottom-2.75 -left-1.5 md:left-1/2 -translate-x-1/2 rotate-90  md:rotate-0">
                                    <svg width="20" height="11" viewBox="0 0 20 11" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M10.207 9.5L1.20703 0.5H18.207L10.207 9.5Z" fill="#FBFBFB" stroke="#E5E5E5"/>
                                    </svg>
                                </div>
                                <h3 class="text-2xl font-semibold leading-none text-title_black">{{ entry.year }}</h3>
                                <p class="text-paragraph_black text-sm  mt-4 font-normal">{{ entry.text }}</p>
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    {% endfor %}
{% endblock %}
