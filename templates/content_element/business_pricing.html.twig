{#
    Preisliste des Business-Themes.

    Wie die uebrigen Business-Inhaltselemente ohne eigenen <section>/.container-
    Rahmen – den liefert das Artikel-Template (mod_article_business_container).
#}
{% extends '@Contao/content_element/_base.html.twig' %}
{% use '@Contao/component/_headline.html.twig' %}
{% use '@Contao/component/_rich_text.html.twig' %}

{% set plan_grid = {
    2: 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-2',
    3: 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3',
    4: 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-4'
} %}

{% block inner %}
    {% if label or headline.text|default or text|default %}
        <div class="flex items-start justify-between gap-4 md:gap-10 mb-12 sm:mb-14 md:mb-16 lg:mb-20 flex-col md:flex-row max-w-125 md:max-w-full" data-section-title>
            <div class="md:max-w-170 w-full">
                {% if label %}
                    <div class="flex items-center gap-2.5">
                        <img class="rotate" src="/files/business/img/title-icon.svg" alt="" width="18" height="18">
                        <span class="text-base lg:text-lg font-semibold leading-[1.1]! text-secondary uppercase block">{{ label }}</span>
                    </div>
                {% endif %}

                {% if headline.text|default %}
                    {% with {headline: {
                        text: headline.text,
                        tag_name: headline.tag_name|default('h2'),
                        attributes: attrs(headline.attributes|default)
                            .addClass('text-3xl md:text-4xl lg:text-[40px] xl:text-5xl font-bold leading-tight text-title_black' ~ (label ? ' mt-4' : ''))
                            .set('data-content')
                    }} %}
                        {{ block('headline_component') }}
                    {% endwith %}
                {% endif %}
            </div>

            {% if text|default %}
                {% with {text, attributes: attrs()
                    .addClass('md:max-w-115 w-full text-base sm:text-lg text-paragraph_black')
                    .set('data-content')
                } %}
                    {{ block('rich_text_component') }}
                {% endwith %}
            {% endif %}
        </div>
    {% endif %}

    {% if plans is not empty %}
        <div class="grid {{ plan_grid[columns] }} gap-6" data-sttr-wrapper>
            {% for plan in plans %}
                <div data-sttr-card>
                    <div class="{{ plan.highlight ? 'bg-secondary border-secondary' : 'bg-background border-border' }} border rounded-2xl p-6 xl:p-8 transition duration-300 flex flex-col justify-between gap-10 md:gap-12 h-full">
                        <div>
                            <p class="text-lg font-semibold leading-none {{ plan.highlight ? 'text-paragraph_white' : 'text-paragraph_black' }}">{{ plan.title }}</p>

                            {% if plan.price or plan.period %}
                                <div class="mt-5 mb-4 flex flex-wrap">
                                    {% if plan.price %}
                                        <h2 class="price text-5xl xl:text-[64px] leading-none group-hover:transition-300 {{ plan.highlight ? 'text-title_white' : 'text-title_black' }}">{{ plan.price }}</h2>
                                    {% endif %}
                                    {% if plan.period %}
                                        <p class="text-base font-normal leading-none items-end flex gap-0.5 pb-2.5 {{ plan.highlight ? 'text-paragraph_white' : 'text-paragraph_black' }}">{{ plan.period }}</p>
                                    {% endif %}
                                </div>
                            {% endif %}

                            {% if plan.description %}
                                <p class="text-base font-normal flex items-end leading-normal {{ plan.highlight ? 'text-paragraph_white' : 'text-paragraph_black' }}">{{ plan.description }}</p>
                            {% endif %}
                        </div>

                        {% if plan.features is not empty %}
                            <ul class="space-y-3">
                                {% for feature in plan.features %}
                                    <li class="flex gap-2 items-start leading-normal text-base font-normal {{ plan.highlight ? 'text-paragraph_white' : 'text-paragraph_black' }}">
                                        {% include 'business/icon.html.twig' with {
                                            icon: 'check_badge',
                                            icon_class: 'w-5 h-5 shrink-0 mt-0.5 fill-current ' ~ (plan.highlight ? 'text-primary' : 'text-title_black')
                                        } only %}
                                        {{ feature }}
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}

                        {% if plan.linkLabel and plan.href %}
                            <a{{ attrs()
                                .set('href', plan.href)
                                .addClass('w-full px-6 py-4 text-base leading-none font-semibold rounded-full cursor-pointer transition duration-300 text-center justify-center!')
                                .addClass(plan.highlight ? 'text-title_black bg-primary' : 'text-title_white bg-title_black hover:text-title_black hover:bg-primary')
                                .set('target', '_blank', plan.target)
                                .set('rel', 'noreferrer noopener', plan.target)
                            }}>{{ plan.linkLabel }}</a>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
