{#
    Teamuebersicht des Business-Themes ("expert-guidness").

    Markup und Klassen stammen 1:1 aus about-us.html.

    Anders als die uebrigen Business-Inhaltselemente bringt dieses Element seinen
    eigenen <section>-Rahmen mit: der dunkle Hintergrund (bg-secondary) muss ueber
    die volle Breite laufen. Das Element gehoert deshalb in einen Artikel OHNE
    Container-Template (also nicht mod_article_business_container).
#}
{% extends '@Contao/content_element/_base.html.twig' %}
{% use '@Contao/component/_headline.html.twig' %}
{% use '@Contao/component/_rich_text.html.twig' %}
{% use '@Contao/component/_picture.html.twig' %}

{% set attributes = attrs().addClass('section-spacing-lg bg-secondary') %}

{% set team_photo = picture_config({
    width: 410,
    height: 520,
    resizeMode: 'crop',
    sizes: '(max-width: 640px) 92vw, (max-width: 1024px) 46vw, 410px',
    densities: '1x, 2x'
}) %}
{% set team_photo_attributes = attrs().addClass('w-full h-full object-cover aspect-410/520 duration-1000 group-hover:transform-[skew(-5deg,5deg)_scale(1.2)]') %}

{% block wrapper_tag %}section{% endblock %}

{% block inner %}
    <div class="container">
        {% if label or headline.text|default or text|default %}
            <div class="flex items-start justify-between gap-4 md:gap-10 mb-12 sm:mb-14 md:mb-16 lg:mb-20 flex-col md:flex-row max-w-125 md:max-w-full" data-section-title>
                <div class="md:max-w-170 w-full">
                    {% if label %}
                        <div class="flex items-center gap-2.5">
                            <img class="rotate" src="/files/business/img/title-icon.svg" alt="" width="18" height="18">
                            <span class="text-base lg:text-lg font-semibold leading-[1.1]! text-primary uppercase">{{ label }}</span>
                        </div>
                    {% endif %}

                    {% if headline.text|default %}
                        {% with {headline: {
                            text: headline.text,
                            tag_name: headline.tag_name|default('h2'),
                            attributes: attrs(headline.attributes|default)
                                .addClass('text-3xl md:text-4xl lg:text-[40px] xl:text-5xl font-bold leading-tight text-title_white' ~ (label ? ' mt-4' : ''))
                                .set('data-content')
                        }} %}
                            {{ block('headline_component') }}
                        {% endwith %}
                    {% endif %}
                </div>

                {% if text|default %}
                    {% with {text, attributes: attrs()
                        .addClass('md:max-w-115 w-full text-base sm:text-lg text-paragraph_white')
                        .set('data-content')
                    } %}
                        {{ block('rich_text_component') }}
                    {% endwith %}
                {% endif %}
            </div>
        {% endif %}

        {% if members is not empty %}
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6" data-sttr-wrapper>
                {% for member in members %}
                    <div data-sttr-card>
                        <div class="blog-card rounded-2xl overflow-hidden relative group block">
                            {% with {figure: figure(member.uuid, team_photo, {metadata: {alt: member.name}}), img_attributes: team_photo_attributes} %}
                                {{ block('picture_component') }}
                            {% endwith %}
                            <div class="absolute z-3 bottom-0 left-0 w-full p-5">
                                <div class="p-6 duration-300 rounded-2xl group-hover:rounded-none bg-white/70 group-hover:bg-transparent backdrop-blur-[34px] group-hover:backdrop-blur-none group-hover:duration-100">
                                    <h3 class="text-xl text-title_black font-semibold leading-none duration-300 group-hover:text-white">{{ member.name }}</h3>
                                    {% if member.position %}
                                        <p class="text-base text-paragraph_black font-normal leading-none mt-2 duration-300 group-hover:text-paragraph_white group-hover:mb-6">{{ member.position }}</p>
                                    {% endif %}

                                    {% if member.socials is not empty %}
                                        <div class="flex gap-5 absolute transition-all duration-500 transform translate-y-10 opacity-0 group-hover:translate-y-0 group-hover:opacity-100">
                                            {% for social in member.socials %}
                                                <a href="{{ social.href }}" class="text-title_white hover:text-primary transition-all duration-500" target="_blank" rel="noreferrer noopener">
                                                    {% include 'business/icon.html.twig' with {icon: social.icon, icon_class: 'w-5 h-5 fill-current'} only %}
                                                </a>
                                            {% endfor %}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}
