{% use "@Contao/component/_picture.html.twig" %}

{# Kartenbild im Stil von case-study.html: Bild oben, abgerundet, Querformat #}
{% set partner_card_image = picture_config({
    width: 700,
    height: 400,
    resizeMode: 'crop',
    sizes: '(max-width: 640px) 92vw, (max-width: 1024px) 46vw, 460px',
    densities: '1x, 2x'
}) %}
{% set partner_card_image_attributes = attrs().addClass('rounded-2xl object-cover w-full aspect-700/400') %}

{# Logos werden nicht beschnitten, damit sie vollstaendig sichtbar bleiben #}
{% set partner_card_logo = picture_config({
    width: 460,
    height: 300,
    resizeMode: 'proportional',
    densities: '1x, 2x'
}) %}
{% set partner_card_logo_attributes = attrs().addClass('max-w-full max-h-full object-contain') %}

{% set pill_base = 'py-2 px-3 inline-block rounded-full text-sm leading-none duration-300 border' %}
{% set pill_idle = 'text-paragraph_black bg-background border-border hover:bg-secondary hover:text-white' %}
{% set pill_active = 'bg-secondary text-white border-secondary' %}

{% block content %}
<section class="section-spacing-lg-md{{ cssClass ? ' ' ~ cssClass }}"{% if cssId %} id="{{ cssId }}"{% endif %}>
  <div class="container">

    <div class="flex items-start justify-between gap-4 md:gap-10 mb-10 sm:mb-12 md:mb-14 flex-col md:flex-row max-w-125 md:max-w-full" data-section-title>
      <div class="md:max-w-170 w-full">
        <div class="flex items-center gap-2.5">
          <img class="rotate" src="/files/business/img/title-icon.svg" alt="" width="18" height="18">
          <span class="text-base lg:text-lg font-semibold leading-[1.1]! text-secondary uppercase block">Partner</span>
        </div>
        <h2 class="text-3xl md:text-4xl lg:text-[40px] xl:text-5xl font-bold leading-tight text-title_black mt-4" data-content>
          {{ headline ?: 'Unsere Partner' }}
        </h2>
      </div>
      <p class="md:max-w-115 w-full text-base sm:text-lg text-paragraph_black" data-content>
        {%- if activeBrancheLabel -%}
          {{ partners|length }} von {{ total }} Partnern in der Branche {{ activeBrancheLabel }}.
        {%- else -%}
          {{ total }} Partner aus {{ branchen|length }} Branchen unterstützen die Bietigheim Steelers.
        {%- endif -%}
      </p>
    </div>

    {% if showFilter %}
      <ul class="flex gap-3 flex-wrap mb-10 sm:mb-12 md:mb-14" aria-label="Nach Branche filtern">
        <li>
          <a href="{{ filterBaseUrl }}" class="{{ pill_base }} {{ activeBranche ? pill_idle : pill_active }}"
             {{- activeBranche ? '' : ' aria-current="true"' }}>Alle Branchen</a>
        </li>
        {% for key, label in branchen %}
          <li>
            <a href="{{ filterBaseUrl }}?branche={{ key|url_encode }}" class="{{ pill_base }} {{ activeBranche == key ? pill_active : pill_idle }}"
               {{- activeBranche == key ? ' aria-current="true"' : '' }}>{{ label }}</a>
          </li>
        {% endfor %}
      </ul>
    {% endif %}

    {% if empty %}
      <p class="text-base sm:text-lg text-paragraph_black">
        {% if activeBrancheLabel %}
          Für die Branche {{ activeBrancheLabel }} sind aktuell keine Partner eingetragen.
        {% else %}
          Aktuell sind keine Partner eingetragen.
        {% endif %}
      </p>
    {% else %}
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6" data-sttr-wrapper>
        {% for partner in partners %}
          {% set link = partner.detailUrl ?: partner.url %}
          {% set isExternal = not partner.detailUrl and partner.url %}
          <div data-sttr-card>
            <div>
              <div>
                {% if link %}
                  <a href="{{ link }}"{% if isExternal %} target="_blank" rel="noreferrer noopener"{% endif %}>
                {% endif %}
                {% if partner.photo %}
                  {% with {figure: figure(partner.photo.uuid, partner_card_image, {metadata: {alt: partner.title}}), img_attributes: partner_card_image_attributes} %}
                    {{ block('picture_component') }}
                  {% endwith %}
                {% else %}
                  <div class="rounded-2xl bg-background border border-border w-full aspect-700/400 flex items-center justify-center p-8">
                    {% if partner.logo %}
                      {% with {figure: figure(partner.logo.uuid, partner_card_logo, {metadata: {alt: partner.title}}), img_attributes: partner_card_logo_attributes} %}
                        {{ block('picture_component') }}
                      {% endwith %}
                    {% else %}
                      <span class="text-xl md:text-2xl font-semibold text-title_black text-center">{{ partner.title }}</span>
                    {% endif %}
                  </div>
                {% endif %}
                {% if link %}
                  </a>
                {% endif %}
              </div>

              {% if partner.brancheLabels is not empty %}
                <div>
                  <ul class="pt-7 flex gap-3 flex-wrap">
                    {% for label in partner.brancheLabels %}
                      <li><span class="{{ pill_base }} {{ pill_idle }}">{{ label }}</span></li>
                    {% endfor %}
                  </ul>
                </div>
              {% endif %}

              <div>
                <h3 class="text-xl md:text-2xl font-semibold">
                  {% if link %}
                    <a href="{{ link }}"{% if isExternal %} target="_blank" rel="noreferrer noopener"{% endif %} class="pt-4 inline-block text-title_black!">
                      {{ partner.title }}
                    </a>
                  {% else %}
                    <span class="pt-4 inline-block text-title_black">{{ partner.title }}</span>
                  {% endif %}
                </h3>
                {% set teaser = partner.teaser ?: partner.description %}
                {% if teaser %}
                  <p class="pt-3 text-paragraph_black line-clamp-2 leading-normal max-w-98.5">{{ teaser|truncate_text(160) }}</p>
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>
{% endblock %}
