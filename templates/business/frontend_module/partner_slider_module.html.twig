{% use "@Contao/component/_picture.html.twig" %}

{# Logos werden nie beschnitten – die Hoehe des Bandes begrenzt die Darstellung #}
{% set partner_logo_config = picture_config({
    width: 400,
    height: 200,
    resizeMode: 'proportional',
    densities: '1x, 2x'
}) %}
{% set partner_logo_attributes = attrs().addClass('max-w-full max-h-full object-contain') %}

{% block content %}
{% if not empty %}
<section class="pt-7 md:pt-10 lg:pt-12 pb-10 md:pb-14 lg:pb-14{{ cssClass ? ' ' ~ cssClass }}"{% if cssId %} id="{{ cssId }}"{% endif %}>

  {% if headline %}
    <div class="container">
      <div class="flex items-start justify-between gap-4 md:gap-10 mb-12 sm:mb-14 md:mb-16 flex-col md:flex-row max-w-125 md:max-w-full" data-section-title>
        <div class="md:max-w-170 w-full">
          <div class="flex items-center gap-2.5">
            <img class="rotate" src="/files/business/img/title-icon.svg" alt="" width="18" height="18">
            <span class="text-base lg:text-lg font-semibold leading-[1.1]! text-secondary uppercase block">Partner</span>
          </div>
          <{{ headlineUnit }} class="text-3xl md:text-4xl lg:text-[40px] xl:text-5xl font-bold leading-tight text-title_black mt-4" data-content>
            {{ headline }}
          </{{ headlineUnit }}>
        </div>
      </div>
    </div>
  {% endif %}

  {# Das Band laeuft absichtlich ueber die volle Breite – kein .container #}
  <div class="mb-7.5">
    <div class="py-6 relative overflow-hidden">
      <img class="absolute top-0 left-0 w-full h-full z-10 pointer-events-none" src="/files/business/img/logos/shadow.webp" alt="" aria-hidden="true">
      {# main.js dupliziert den Inhalt dieses Elements und verschiebt es per transform #}
      <div class="marquee-slider flex items-center gap-10 md:gap-15 will-change-transform">
        {% for logo in items %}
          <div class="shrink-0 flex items-center justify-center w-25 sm:w-auto max-w-50 h-10 sm:h-12">
            {% if logo.href %}
              <a href="{{ logo.href }}"{% if logo.external %} target="_blank" rel="noreferrer noopener"{% endif %} class="flex items-center justify-center max-w-full max-h-full">
            {% endif %}
            {% with {figure: figure(logo.uuid, partner_logo_config, {metadata: {alt: logo.title}}), img_attributes: partner_logo_attributes} %}
              {{ block('picture_component') }}
            {% endwith %}
            {% if logo.href %}
              </a>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
{% endif %}
{% endblock %}
