{#
    Eingabefeld des Newsletter-Formulars im Footer (Business-Theme).
    Im Formularfeld als Template auswaehlen. Label wird als Screenreader-Text ausgegeben.
#}
{% set wrapperAttributes = attrs()
    .addClass(['relative', this.class|default])
    .mergeWith(wrapperAttributes|default)
%}

<div{{ wrapperAttributes }}>
    {% if this.label %}
        <label for="ctrl_{{ this.id }}" class="sr-only">
            {{ this.label|insert_tag_raw }}{% if this.mandatory|default %} *{% endif %}
        </label>
    {% endif %}

    {% set inputAttributes = attrs(getAttributes.invoke()) %}
    {% set inputType = this.rgxp|default == 'email' ? 'email' : this.type %}

    <input{{ attrs()
        .set('type', inputType)
        .set('name', this.name)
        .set('id', "ctrl_#{this.id}")
        .addClass('w-full h-12 border border-paragraph_white rounded-[100px] p-4 pr-11 text-white duration-300 focus:border-primary placeholder:text-paragraph_white outline-0 focus:bg-white/10 focus:backdrop-blur-2xl')
        .addClass(this.class|default)
        .set('value', this.value|default|insert_tag)
        .mergeWith(inputAttributes)
        .setIfExists('placeholder', inputAttributes.placeholder|default|insert_tag)
    }}>

    {% if hasErrors.invoke() %}
        <span class="block mt-2 text-sm text-red-400" role="alert">{{ getErrorAsString.invoke() }}</span>
    {% endif %}
</div>
