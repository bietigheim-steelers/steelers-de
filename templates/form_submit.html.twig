{% extends 'form_row.html.twig' %}

{% block field %}
    {% if this.src|default %}
        <input{{ attrs()
            .set('type', 'image')
            .set('src', this.src)
            .set('id', "ctrl_#{this.id}")
            .addClass('submit')
            .addClass(this.class|default)
            .set('title', this.slabel)
            .set('alt', this.slabel)
            .set('data-submit-lock')
            .mergeWith(getAttributes.invoke())
        }}>
    {% else %}
        <button{{ attrs()
            .set('type', 'submit')
            .set('id', "ctrl_#{this.id}")
            .addClass(['submit', 'btn-default', this.class|default])
            .set('data-submit-lock')
            .set('data-submit-lock-label', 'Bitte warten …')
            .mergeWith(getAttributes.invoke())
        }}>{{ this.slabel }}</button>
    {% endif %}

    {# Verhindert, dass das Formular mehrfach abgeschickt wird #}
    {% include 'custom/submit_lock.html.twig' %}
{% endblock %}
