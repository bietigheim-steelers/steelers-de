{% use "@Contao/component/_figure.html.twig" %}

{% set wrapperAttributes = attrs(cssID|default)
    .addClass([class, 'defaultcontainer', 'form-home', 'bg-black', 'relative', '!mt-32', 'xl:!mt-64'])
    .addStyle(style|default)
%}

<!-- indexer::stop -->
<div{{ wrapperAttributes }}>
    {% set image = figure('files/steelers/layout/newsletter_laptop.png', [700, 700, 'proportional']) %}
    {% if image %}
        {% with {figure: image, img_attributes: attrs().addClass(['hidden', 'lg:block', 'absolute', 'bottom-0']).set('loading', 'lazy')} %}
            {{ block('picture_component') }}
        {% endwith %}
    {% endif %}

    <div class="grid lg:grid-cols-2">
        <div class="formbody text-steelwhite offset lg:col-start-2 p-10">
            <p class=" uppercase text-base font-bold leading-5 pb-5 pr-5">Du möchtest regelmäßig alle News erhalten?</p>
            <p class="uppercase text-2xl font-bold pb-8 pr-5">Hinterlasse deine E-Mail-Adresse, um auf dem Laufenden zu bleiben.</p>
            <p>
                <a href="/newsletter" class="btn-default">Zur Anmeldung</a>
            </p>
        </div>
    </div>
</div>
<!-- indexer::continue -->
