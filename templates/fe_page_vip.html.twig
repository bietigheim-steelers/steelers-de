{% extends "fe_page.html.twig" %}

{% set bodyAttributes = attrs(bodyAttributes|default)
	.addClass(['overflow-hidden'])
%}

{% block body %}
	<div class="relative flex w-full flex-col overflow-hidden" style="height: 100dvh;">
		<img src="/files/steelers/layout/bg_vip.png" alt="" role="presentation"
			class="pointer-events-none absolute inset-0 h-full w-full object-fill">

		<header class="shrink-0 flex justify-center px-4 pt-6 sm:pt-20">
			<img src="/files/steelers/layout/logo-nav.svg" alt="" width="260" style="z-index: 10;">
		</header>

		<main id="main" class="relative min-h-0 flex-1 overflow-hidden px-28">
			{{ main|raw }}
		</main>
	</div>
{% endblock %}
